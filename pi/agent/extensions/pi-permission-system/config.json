{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "path": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".git/*": "deny",
      "**/.git/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push * --force": "deny",
      "git push * -f": "deny",
      "git branch -D *": "deny",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "dotnet build *": "allow",
      "dotnet restore *": "allow",
      "shutdown *": "deny",
      "reboot *": "deny"
    }
  }
}
