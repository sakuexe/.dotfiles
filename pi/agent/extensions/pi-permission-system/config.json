{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",

    "path": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      ".git/*": "deny",
      "**/.git/**": "deny"
    },

    "external_directory": {
      "*": "ask",
      "~/.pi/agent": "allow",
      "~/.pi/agent/settings.json": "allow",
      "~/.pi/agent/extensions/**": "allow",
      "/tmp/**": "allow",
      "/nix/store/*-pi-coding-agent-*/**": "allow",

      "~/.microsoft/usersecrets/**": "deny"
    },

    "fetch_content": "allow",
    "web_search": "allow",

    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push --force *": "deny"
    }
  }
}
